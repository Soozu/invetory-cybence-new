generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
  EXPIRED
  CANCELLED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SerialStatus {
  AVAILABLE
  MISSING
  ISSUED
  ASSIGNED
  RESERVED
  DEFECTIVE
  FOR_REPAIR
  RETURNED
  DISPOSED
  RETURN_PENDING
  QUARANTINE
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  PURCHASE_RECEIVING
  RETURN
  DAMAGE
  CORRECTION
  OPENING_STOCK
  ASSET_ASSIGNMENT
  ASSET_RETURN
  RESERVATION_CREATED
  RESERVATION_RELEASED
  RESERVATION_EXPIRED
  SUPPLIER_RETURN
  RETURN_HOLD
  RETURN_RELEASE
  CONDITION_CHANGED
}

enum AdjustmentType {
  STOCK_IN
  STOCK_OUT
  CORRECTION
  DAMAGE
  RETURN
  OPENING_STOCK
}

enum TransferStatus {
  DRAFT
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
  PARTIAL
  DISCREPANCY
  RESOLVED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
  DISPOSED
  QUARANTINE
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_REPAIR
  COMPLETED
  CANCELLED
}

model User {
  sessions Session[]
  authVersion Int @default(0)
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  lastFailedLoginAt DateTime?
  preferences UserPreference?
  savedReports SavedReport[]
  imports ImportBatch[] @relation("ImportUploader")
  confirmedImports ImportBatch[] @relation("ImportConfirmer")
  attachments Attachment[] @relation("AttachmentUploader")
  archivedAttachments Attachment[] @relation("AttachmentArchiver")
  id String @id @default(cuid())
  firstName String
  lastName String
  email String @unique
  passwordHash String
  roleId String
  warehouseId String?
  avatar String?
  phone String?
  status UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role Role @relation(fields: [roleId], references: [id])
  warehouse Warehouse? @relation("WarehouseUsers", fields: [warehouseId], references: [id])
  warehouseAssignments UserWarehouse[]
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  refreshTokens RefreshToken[]
  requestedTransfers StockTransfer[] @relation("TransferRequester")
  approvedTransfers StockTransfer[] @relation("TransferApprover")
  receivedTransfers StockTransfer[] @relation("TransferReceiver")
  createdOrders PurchaseOrder[] @relation("OrderCreator")
  approvedOrders PurchaseOrder[] @relation("OrderApprover")
  adjustments StockAdjustment[]
  movements StockMovement[]
  receipts PurchaseReceipt[]
  assetAssignments AssetAssignment[] @relation("AssignmentIssuer")
  assetReturns AssetAssignment[] @relation("AssignmentReceiver")
  assetEvents AssetEvent[]
  warrantyClaimEvents WarrantyClaimEvent[]
  maintenanceRecords MaintenanceRecord[]
  notifications Notification[]
  activityLogs ActivityLog[]
  updatedSettings SystemSetting[]
  createdStockCounts StockCount[] @relation("CountCreator")
  inventoryReservations InventoryReservation[]
  approvedStockCounts StockCount[] @relation("CountApprover")
  serialEvents SerialEvent[]
  purchaseRequests PurchaseRequest[] @relation("RequestCreator")
  approvedPurchaseRequests PurchaseRequest[] @relation("RequestApprover")
  rejectedPurchaseRequests PurchaseRequest[] @relation("RequestRejector")
  rfqs RFQ[] @relation("RFQCreator")
  awardedRFQs RFQ[] @relation("RFQAwarder")
  supplierReturns SupplierReturn[] @relation("ReturnCreator")
  approvedSupplierReturns SupplierReturn[] @relation("ReturnApprover")
  conditionChanges StockConditionChange[]
  transferArrivals TransferArrival[]
  transferResolutions TransferDiscrepancyResolution[]
  @@index([roleId])
  @@index([warehouseId])
}

model UserWarehouse {
  id String @id @default(cuid())
  userId String
  warehouseId String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@unique([userId, warehouseId])
  @@index([warehouseId])
}

model RefreshToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Session {
  id String @id @default(cuid())
  userId String
  refreshTokenHash String? @unique @db.Char(64)
  authVersion Int
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  module String
  action String
  description String?
  roles RolePermission[]
  @@unique([module, action])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  parentId String?
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
}

model Brand {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  logo String?
  description String?
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}

model Supplier {
  id String @id @default(cuid())
  companyName String @unique
  supplierCode String @unique
  contactPerson String?
  email String?
  phone String?
  address String?
  taxId String?
  paymentTerms String?
  notes String? @db.Text
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  serialNumbers SerialNumber[]
  purchaseOrders PurchaseOrder[]
  rfqInvitations RFQSupplier[]
  quotations SupplierQuotation[]
  returns SupplierReturn[]
  warrantyClaims WarrantyClaim[]
}

model Warehouse {
  imports ImportBatch[]
  id String @id @default(cuid())
  name String @unique
  code String @unique
  address String?
  managerId String?
  phone String?
  email String?
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manager User? @relation("WarehouseManager", fields: [managerId], references: [id])
  users User[] @relation("WarehouseUsers")
  userAssignments UserWarehouse[]
  stock WarehouseStock[]
  serialNumbers SerialNumber[]
  movements StockMovement[] @relation("MovementWarehouse")
  sourceMovements StockMovement[] @relation("MovementSource")
  destinationMovements StockMovement[] @relation("MovementDestination")
  adjustments StockAdjustment[]
  outgoingTransfers StockTransfer[] @relation("TransferSource")
  incomingTransfers StockTransfer[] @relation("TransferDestination")
  purchaseOrders PurchaseOrder[]
  receipts PurchaseReceipt[]
  assets Asset[]
  assetAssignments AssetAssignment[]
  assetEvents AssetEvent[]
  maintenanceRecords MaintenanceRecord[]
  warrantyClaims WarrantyClaim[]
  stockCounts StockCount[]
  reservations InventoryReservation[]
  serialEvents SerialEvent[] @relation("SerialEventWarehouse")
  relatedSerialEvents SerialEvent[] @relation("SerialEventRelatedWarehouse")
  purchaseRequests PurchaseRequest[]
  rfqs RFQ[]
  supplierReturns SupplierReturn[]
  conditionChanges StockConditionChange[]
  @@index([managerId])
}

model Product {
  id String @id @default(cuid())
  name String
  sku String @unique
  barcode String? @unique
  categoryId String
  brandId String
  defaultSupplierId String?
  model String?
  description String? @db.Text
  unit String @default("pcs")
  minimumStock Int @default(0)
  maximumStock Int @default(0)
  reorderPoint Int @default(0)
  purchaseCost Decimal @default(0) @db.Decimal(14, 2)
  warrantyMonths Int @default(0)
  trackSerialNumbers Boolean @default(false)
  image String?
  status ProductStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category Category @relation(fields: [categoryId], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])
  defaultSupplier Supplier? @relation(fields: [defaultSupplierId], references: [id])
  stocks WarehouseStock[]
  serialNumbers SerialNumber[]
  movements StockMovement[]
  adjustments StockAdjustment[]
  transferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems PurchaseReceiptItem[]
  assets Asset[]
  stockCountItems StockCountItem[]
  reservationItems InventoryReservationItem[]
  purchaseRequestItems PurchaseRequestItem[]
  rfqItems RFQItem[]
  supplierReturnItems SupplierReturnItem[]
  conditionChanges StockConditionChange[]
  @@index([categoryId])
  @@index([brandId])
  @@index([defaultSupplierId])
  @@index([status, name])
}

model WarehouseStock {
  id String @id @default(cuid())
  productId String
  warehouseId String
  quantity Int @default(0)
  reservedQuantity Int @default(0)
  quarantineQuantity Int @default(0)
  defectiveQuantity Int @default(0)
  forRepairQuantity Int @default(0)
  returnPendingQuantity Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model SerialNumber {
  id String @id @default(cuid())
  serialNumber String @unique
  productId String
  warehouseId String?
  purchaseOrderItemId String?
  supplierId String?
  warrantyStart DateTime?
  warrantyEnd DateTime?
  status SerialStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  asset Asset?
  maintenanceRecords MaintenanceRecord[]
  transferSelections StockTransferSerial[]
  countSnapshots StockCountSerial[]
  reservationSelections InventoryReservationSerial[]
  receiptId String?
  receipt PurchaseReceipt? @relation(fields: [receiptId], references: [id])
  events SerialEvent[]
  returnSelections SupplierReturnSerial[]
  conditionSelections StockConditionSerial[]
  transferDiscrepancies TransferDiscrepancy[]
  warrantyClaims WarrantyClaim[]
  @@index([productId, status])
  @@index([warehouseId])
  @@index([warrantyEnd])
}

model StockMovement {
  id String @id @default(cuid())
  referenceNumber String
  productId String
  warehouseId String
  type MovementType
  quantity Int
  previousQuantity Int
  newQuantity Int
  previousReservedQuantity Int?
  newReservedQuantity Int?
  sourceWarehouseId String?
  destinationWarehouseId String?
  userId String?
  notes String? @db.Text
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse Warehouse? @relation("MovementSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("MovementDestination", fields: [destinationWarehouseId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceNumber])
  conditionChange StockConditionChange?
  transferResolutions TransferDiscrepancyResolution[]
}

model StockAdjustment {
  countItem StockCountItem?
  id String @id @default(cuid())
  referenceNumber String @unique
  productId String
  warehouseId String
  type AdjustmentType
  quantity Int
  reason String
  notes String? @db.Text
  userId String
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
}

model StockTransfer {
  id String @id @default(cuid())
  transferNumber String @unique
  sourceWarehouseId String
  destinationWarehouseId String
  requestedById String
  approvedById String?
  receivedById String?
  status TransferStatus @default(DRAFT)
  notes String? @db.Text
  requestedAt DateTime @default(now())
  approvedAt DateTime?
  shippedAt DateTime?
  receivedAt DateTime?
  arrivalClosedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sourceWarehouse Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  requestedBy User @relation("TransferRequester", fields: [requestedById], references: [id])
  approvedBy User? @relation("TransferApprover", fields: [approvedById], references: [id])
  receivedBy User? @relation("TransferReceiver", fields: [receivedById], references: [id])
  items StockTransferItem[]
  arrivals TransferArrival[]
  discrepancies TransferDiscrepancy[]
  @@index([status, createdAt])
}

model StockTransferItem {
  id String @id @default(cuid())
  transferId String
  productId String
  quantity Int
  receivedQuantity Int @default(0)
  lostQuantity Int @default(0)
  returnedQuantity Int @default(0)
  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  serialSelections StockTransferSerial[]
  discrepancies TransferDiscrepancy[]
  @@index([productId])
}

model StockTransferSerial {
  transferItemId String
  serialNumberId String
  outcome String @default("IN_TRANSIT")
  transferItem StockTransferItem @relation(fields: [transferItemId], references: [id])
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id])
  @@id([transferItemId, serialNumberId])
  @@index([serialNumberId])
}

// Immutable arrival payload contains validated item/serial/movement identities.
model TransferArrival {
  id String @id @default(cuid())
  referenceNumber String @unique
  transferId String
  receivedById String
  finalArrival Boolean @default(false)
  lines Json
  notes String @db.Text
  createdAt DateTime @default(now())
  transfer StockTransfer @relation(fields: [transferId], references: [id])
  receivedBy User @relation(fields: [receivedById], references: [id])
  discrepancies TransferDiscrepancy[]
  @@index([transferId, createdAt])
}

model TransferDiscrepancy {
  id String @id @default(cuid())
  transferId String
  transferItemId String
  arrivalId String
  kind String
  quantity Int
  resolvedQuantity Int @default(0)
  serialNumberId String?
  observedSerial String?
  notes String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transfer StockTransfer @relation(fields: [transferId], references: [id])
  transferItem StockTransferItem @relation(fields: [transferItemId], references: [id])
  arrival TransferArrival @relation(fields: [arrivalId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  resolutions TransferDiscrepancyResolution[]
  @@index([transferId, createdAt])
  @@index([serialNumberId])
}

model TransferDiscrepancyResolution {
  id String @id @default(cuid())
  discrepancyId String
  action String
  quantity Int
  notes String @db.Text
  userId String
  stockMovementId String?
  createdAt DateTime @default(now())
  discrepancy TransferDiscrepancy @relation(fields: [discrepancyId], references: [id])
  user User @relation(fields: [userId], references: [id])
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  @@index([discrepancyId, createdAt])
}

model PurchaseOrder {
  id String @id @default(cuid())
  poNumber String @unique
  supplierId String
  warehouseId String
  createdById String
  approvedById String?
  orderDate DateTime @default(now())
  expectedDelivery DateTime?
  reference String?
  notes String? @db.Text
  subtotal Decimal @db.Decimal(14, 2)
  tax Decimal @default(0) @db.Decimal(14, 2)
  shipping Decimal @default(0) @db.Decimal(14, 2)
  total Decimal @db.Decimal(14, 2)
  status PurchaseOrderStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User @relation("OrderCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("OrderApprover", fields: [approvedById], references: [id])
  items PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  sourcePurchaseRequest PurchaseRequest?
  sourceQuotation SupplierQuotation?
  supplierReturns SupplierReturn[]
  @@index([supplierId, status])
  @@index([warehouseId, orderDate])
}

model PurchaseOrderItem {
  id String @id @default(cuid())
  purchaseOrderId String
  productId String
  quantity Int
  unitCost Decimal @db.Decimal(14, 2)
  receivedQuantity Int @default(0)
  subtotal Decimal @db.Decimal(14, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  receiptItems PurchaseReceiptItem[]
  serialNumbers SerialNumber[]
  @@index([productId])
}

model PurchaseReceipt {
  id String @id @default(cuid())
  receiptNumber String @unique
  purchaseOrderId String
  warehouseId String
  receivedById String
  receivedAt DateTime @default(now())
  notes String? @db.Text
  createdAt DateTime @default(now())
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  receivedBy User @relation(fields: [receivedById], references: [id])
  items PurchaseReceiptItem[]
  serialNumbers SerialNumber[]
  @@index([purchaseOrderId, receivedAt])
  supplierReturns SupplierReturn[]
  warrantyClaims WarrantyClaim[]
}

model PurchaseReceiptItem {
  id String @id @default(cuid())
  receiptId String
  purchaseOrderItemId String
  productId String
  quantity Int
  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([purchaseOrderItemId])
  supplierReturnItems SupplierReturnItem[]
}

enum SupplierReturnStatus {
  DRAFT
  PENDING
  APPROVED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum SupplierReturnReason {
  DEFECTIVE
  WRONG_ITEM
  DAMAGED
  WARRANTY
  OVER_DELIVERY
  OTHER
}

enum ReturnCondition {
  AVAILABLE
  DEFECTIVE
  DAMAGED
  FOR_REPAIR
}

model SupplierReturn {
  warrantyClaims WarrantyClaim[]
  id String @id @default(cuid())
  returnNumber String @unique
  supplierId String
  purchaseOrderId String
  receiptId String
  warehouseId String
  status SupplierReturnStatus @default(DRAFT)
  reason SupplierReturnReason
  createdById String
  approvedById String?
  submittedAt DateTime?
  approvedAt DateTime?
  returnedAt DateTime?
  completedAt DateTime?
  notes String? @db.Text
  shipmentReference String? @db.VarChar(191)
  completionNotes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User @relation("ReturnCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("ReturnApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items SupplierReturnItem[]
  @@index([warehouseId, status, createdAt])
  @@index([receiptId, status])
  @@index([supplierId, createdAt])
}

model SupplierReturnItem {
  id String @id @default(cuid())
  supplierReturnId String
  receiptItemId String
  productId String
  quantity Int
  reason SupplierReturnReason
  condition ReturnCondition
  heldQuantity Int @default(0)
  stockCondition StockCondition @default(AVAILABLE)
  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  receiptItem PurchaseReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  serialSelections SupplierReturnSerial[]
  @@unique([supplierReturnId, receiptItemId])
  @@index([receiptItemId])
  @@index([productId])
}

model SupplierReturnSerial {
  returnItemId String
  serialNumberId String
  previousStatus SerialStatus
  returnItem SupplierReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  @@id([returnItemId, serialNumberId])
  @@index([serialNumberId])
}

enum StockCondition {
  AVAILABLE
  QUARANTINE
  DEFECTIVE
  FOR_REPAIR
}

model StockConditionChange {
  id String @id @default(cuid())
  referenceNumber String @unique
  productId String
  warehouseId String
  userId String
  fromCondition StockCondition
  toCondition StockCondition
  quantity Int
  reason String @db.VarChar(1000)
  beforeBalances Json
  afterBalances Json
  stockMovementId String @unique
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  stockMovement StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  serialSelections StockConditionSerial[]
  @@index([warehouseId, createdAt])
  @@index([productId, createdAt])
}

model StockConditionSerial {
  conditionChangeId String
  serialNumberId String
  conditionChange StockConditionChange @relation(fields: [conditionChangeId], references: [id], onDelete: Restrict)
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  @@id([conditionChangeId, serialNumberId])
  @@index([serialNumberId])
}

model Asset {
  id String @id @default(cuid())
  assetTag String @unique
  productId String
  serialNumberId String? @unique
  warehouseId String?
  purchaseDate DateTime?
  status AssetStatus @default(AVAILABLE)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id])
  serialNumber SerialNumber? @relation(fields: [serialNumberId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  assignments AssetAssignment[]
  maintenanceRecords MaintenanceRecord[]
  servicePreviousStatus String?
  servicePreviousSerialStatus String?
  events AssetEvent[]
  maintenancePlans PreventiveMaintenancePlan[]
  warrantyClaims WarrantyClaim[]
  @@index([status, warehouseId])
}

model AssetAssignment {
  id String @id @default(cuid())
  assetId String
  assignedTo String
  department String?
  location String?
  assignedById String?
  assignedDate DateTime @default(now())
  returnedDate DateTime?
  conditionOnAssign String?
  conditionOnReturn String?
  notes String? @db.Text
  status AssignmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset Asset @relation(fields: [assetId], references: [id])
