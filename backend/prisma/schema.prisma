enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

model PurchaseRequest {
  id String @id @default(cuid())
  prNumber String @unique
  requestedById String
  department String
  warehouseId String
  requiredDate DateTime?
  justification String @db.Text
  status PurchaseRequestStatus @default(DRAFT)
  approvedById String?
  rejectedById String?
  approvalNotes String? @db.Text
  submittedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?
  convertedAt DateTime?
  purchaseOrderId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requestedBy User @relation("RequestCreator", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("RequestRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items PurchaseRequestItem[]
  rfqs RFQ[]
  @@index([warehouseId, status, createdAt])
  @@index([requestedById, createdAt])
}

model PurchaseRequestItem {
  id String @id @default(cuid())
  purchaseRequestId String
  productId String?
  description String @db.VarChar(500)
  quantity Int
  estimatedUnitCost Decimal @default(0) @db.Decimal(14, 2)
  notes String? @db.Text
  request PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  rfqItems RFQItem[]
  @@index([purchaseRequestId])
  @@index([productId])
}

enum RFQStatus {
  DRAFT
  ISSUED
  CLOSED
  AWARDED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  CONVERTED
  CANCELLED
}

model RFQ {
  id String @id @default(cuid())
  rfqNumber String @unique
  purchaseRequestId String?
  warehouseId String
  createdById String
  status RFQStatus @default(DRAFT)
  closingDate DateTime?
  issuedAt DateTime?
  closedAt DateTime?
  notes String? @db.Text
  selectedQuotationId String? @unique
  selectedById String?
  selectedAt DateTime?
  selectionNotes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User @relation("RFQCreator", fields: [createdById], references: [id], onDelete: Restrict)
  selectedBy User? @relation("RFQAwarder", fields: [selectedById], references: [id], onDelete: SetNull)
  selectedQuotation SupplierQuotation? @relation("AwardedQuotation", fields: [selectedQuotationId], references: [id], onDelete: Restrict)
  quotations SupplierQuotation[] @relation("RFQQuotations")
  suppliers RFQSupplier[]
  items RFQItem[]
  @@index([warehouseId, status, createdAt])
  @@index([purchaseRequestId, status])
}

model RFQItem {
  id String @id @default(cuid())
  rfqId String
  purchaseRequestItemId String?
  productId String?
  description String @db.VarChar(500)
  quantity Int
  notes String? @db.Text
  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem? @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotationItems SupplierQuotationItem[]
  @@index([rfqId])
  @@index([purchaseRequestItemId])
  @@index([productId])
}

model RFQSupplier {
  id String @id @default(cuid())
  rfqId String
  supplierId String
  invitedAt DateTime?
  respondedAt DateTime?
  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

model SupplierQuotation {
  id String @id @default(cuid())
  quotationNumber String @unique
  supplierReference String?
  rfqId String
  supplierId String
  quotationDate DateTime
  validUntil DateTime?
  deliveryDays Int?
  paymentTerms String?
  subtotal Decimal @db.Decimal(14,2)
  tax Decimal @default(0) @db.Decimal(14,2)
  shipping Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  notes String? @db.Text
  status QuotationStatus @default(DRAFT)
  purchaseOrderId String? @unique
  submittedAt DateTime?
  convertedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rfq RFQ @relation("RFQQuotations", fields: [rfqId], references: [id], onDelete: Restrict)
  award RFQ? @relation("AwardedQuotation")
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items SupplierQuotationItem[]
  @@unique([rfqId, supplierId])
  @@index([status, createdAt])
}

model SupplierQuotationItem {
  id String @id @default(cuid())
  quotationId String
  rfqItemId String
  description String @db.VarChar(500)
  quantity Int
  unitPrice Decimal @db.Decimal(14,2)
  subtotal Decimal @db.Decimal(14,2)
  brandOffered String?
  modelOffered String?
  notes String? @db.Text
  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem RFQItem @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)
  @@unique([quotationId, rfqItemId])
  @@index([rfqItemId])
}

// Generic parent identity is resolved and authorized by attachmentSources on every request.
model Attachment {
  id String @id @default(cuid())
  entityType String @db.VarChar(40)
  entityId String @db.VarChar(191)
  fileName String @db.VarChar(180)
  storedName String
  mimeType String
  size Int
  storageProvider String @default("LOCAL")
  storageKey String @unique
  sha256 String @db.Char(64)
  requestKey String @db.Char(36)
  warehouseId String?
  relatedWarehouseId String?
  uploadedById String
  archivedById String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  archivedBy User? @relation("AttachmentArchiver", fields: [archivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([entityType, entityId, uploadedById, requestKey])
  @@index([entityType, entityId, archivedAt, createdAt])
}

// JSON holds temporary CSV staging only. Confirmed masters and stock remain relational.
model ImportBatch {
  id String @id @default(cuid())
  type String @db.VarChar(40)
  fileName String @db.VarChar(184)
  sha256 String @db.Char(64)
  requestKey String @db.Char(36)
  uploadedById String
  confirmedById String?
  warehouseId String?
  status String @default("PREVIEW") @db.VarChar(20)
  revision Int @default(1)
  rows Json
  result Json?
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  expiresAt DateTime
  confirmedAt DateTime?
  uploadedBy User @relation("ImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("ImportConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([uploadedById, requestKey])
  @@index([uploadedById, status, createdAt])
  @@index([warehouseId])
}
