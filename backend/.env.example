NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://techstock_user:replace_me@localhost:3306/techstock_inventory"
FRONTEND_URL=http://localhost:5173,http://localhost:5174
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
JOBS_ENABLED=true
# 0 = manual only. Otherwise 60–10080 minutes.
BACKUP_INTERVAL_MINUTES=0
BACKUP_STORAGE_DIR=.private-storage/backups
# Set absolute tool paths on other hosts. Windows MySQL 8.0 is detected locally.
MYSQLDUMP_PATH=
MYSQL_PATH=
ATTACHMENT_STORAGE_PROVIDER=LOCAL
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_TYPES=pdf,png,jpg,jpeg,webp,docx,xlsx
# Private directory outside public uploads. Include it in server backups.
ATTACHMENT_STORAGE_DIR=.private-storage/attachments
# Administrator-only bootstrap. Set your own credentials before the first seed.
SEED_ADMIN_EMAIL=admin@techstock.local
SEED_ADMIN_PASSWORD=Admin123!
